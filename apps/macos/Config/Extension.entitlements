<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- 连接回环 127.0.0.1:<bridgePort>（原生桥候选 A）。 -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)sfe</string>
	</array>
	<!-- 首选的登录钥匙串方案不需要 keychain-access-groups（受限权限，需要描述文件）。备选方案
	     （SFE_DATA_PROTECTION_KEYCHAIN）改用 Extension-DataProtection.entitlements，见 project.yml 与 README。 -->
</dict>
</plist>
