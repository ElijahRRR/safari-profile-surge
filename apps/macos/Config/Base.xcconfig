// 公共构建设置（XcodeGen 的 configFiles 引用）。
// DEVELOPMENT_TEAM、SFE_NODE_BINARY、SFE_NODE_VERSION 来自未跟踪的 apps/macos/Local.xcconfig（见 Local.xcconfig.example）。
// 这里先给空默认值，Local.xcconfig 中的值覆盖它们；缺失时 embed-runtime.sh 会让构建失败并说明原因。

DEVELOPMENT_TEAM =
SFE_NODE_BINARY =
SFE_NODE_VERSION =

#include? "../Local.xcconfig"

// App Group 与钥匙串访问组。entitlements 中写 $(TeamIdentifierPrefix)sfe 与 $(AppIdentifierPrefix)com.sfe.shared，
// Info.plist 中写下面两个值供代码读取；两者都应展开为 <Team ID>.sfe 与 <Team ID>.com.sfe.shared。
SFE_APP_GROUP_ID = $(DEVELOPMENT_TEAM).sfe
SFE_KEYCHAIN_ACCESS_GROUP = $(DEVELOPMENT_TEAM).com.sfe.shared
