<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 只用于备选钥匙串方案：与 SWIFT_ACTIVE_COMPILATION_CONDITIONS 中的 SFE_DATA_PROTECTION_KEYCHAIN 同时启用。
	     除 keychain-access-groups 外与 Extension.entitlements 相同，两份需保持一致。 -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- 连接回环 127.0.0.1:<bridgePort>（原生桥候选 A）。 -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)sfe</string>
	</array>
	<!-- 数据保护钥匙串的共享访问组。受限权限：签名时需要描述文件授权（免费 Personal Team 约 7 天过期），
	     只在 extension_install_persistence 证明不会因此失效时采用。 -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.sfe.shared</string>
	</array>
</dict>
</plist>
