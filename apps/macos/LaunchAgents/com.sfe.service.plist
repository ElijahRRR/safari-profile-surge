<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sfe.service</string>
	<!--
	  BundleProgram 相对 App 包解析；ProgramArguments 中的相对路径不会被解析（按 / 解析），
	  因此由 sfe-service-launcher 按自身位置找到 Contents/Helpers/node 与
	  Contents/Resources/service/service.mjs 的绝对路径后 execv。不带演示参数，不含任何秘密或环境变量。
	-->
	<key>BundleProgram</key>
	<string>Contents/Helpers/sfe-service-launcher</string>
	<key>ProgramArguments</key>
	<array>
		<string>sfe-service-launcher</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.sfe.SafariProfileSurge</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- 只在异常退出（崩溃或非零退出码）时重启；正常停止不重启。 -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>30</integer>
</dict>
</plist>
